# Testiympäristön compose-asetukset. dev/setup.sh luo tästä .env:n ja asettaa
# AIRFLOW_UID:n omaksi käyttäjätunnukseksesi (id -u), jolloin lokit, venv ja
# tuotokset ovat sinun omistamiasi eivätkä rootin.
AIRFLOW_UID=50000

# Hostin portit: Airflow UI ja InfluxDB UI
#TEST_AIRFLOW_PORT=8082
#TEST_INFLUX_PORT=8097

# Airflow-image. Oletus vastaa tuotantoa.
#AIRFLOW_IMAGE_NAME=apache/airflow:3.0.4
