# mtconnect_data_dag -- tunnukset.
#
# Kopioi tämä nimelle .env ja täytä arvot. .env EI kuulu versionhallintaan.
# Rajaa oikeudet luonnin jälkeen:  chmod 600 .env
# Testiympäristössä dev/setup.sh luo .env:n automaattisesti dev/test.env:n arvoista.
#
# Venvissä ei ole Airflow'ta, joten Connectioneja ei voi lukea -- tunnukset tulevat
# täältä. Arvot eivät saa päätyä lokiin; koodi kirjoittaa kohteesta vain
# host/tietokanta-osan (ks. _dsn_label core-moduulissa).

# --- InfluxDB, konedatan lähde ---
INFLUX_URL=https://influxdb.example:8086
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=MACHINE_DATA

# --- PostgreSQL, konetapahtumien kohde ---
# Kohdetaulun on oltava olemassa tietomallin mukaisena -- DAG ei luo sitä.
PG_DSN=postgresql://kayttaja:salasana@host:5432/warehouse

# Varakanta. Käytetään VAIN jos PG_DSN puuttuu, ja siitä varoitetaan lokissa
# äänekkäästi. Tyhjä = ei varaa, jolloin puuttuva PG_DSN kaataa ajon.
#PG_DSN_FALLBACK=postgresql://kayttaja:salasana@host:5432/warehouse
