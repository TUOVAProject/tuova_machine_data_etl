# Testiympäristön arvot (docker-compose.yaml). EIVÄT ole salaisuuksia: ne ovat
# olemassa vain paikallisissa testikonteissa. Määritelty kerran tässä, ja kaikki
# palvelut sekä DAGin .env (dev/setup.sh) lukevat samat arvot.
# Järjestys on merkitsevä: ${...} viittaa vain ylempänä määriteltyyn.

# --- Tietovarasto (warehouse-kontti)
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=local-test-password
POSTGRES_DB=warehouse

# --- DAGin tunnukset: samat avaimet kuin config/python-venvs/mtconnect_data_dag/.env.example
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=test-org
INFLUX_BUCKET=MACHINE_DATA
INFLUX_TOKEN=local-test-token
PG_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@warehouse:5432/${POSTGRES_DB}

# --- InfluxDB:n ensikäynnistys: sama org, bucket ja token kuin yllä
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=local-test-password
DOCKER_INFLUXDB_INIT_ORG=${INFLUX_ORG}
DOCKER_INFLUXDB_INIT_BUCKET=${INFLUX_BUCKET}
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=${INFLUX_TOKEN}
